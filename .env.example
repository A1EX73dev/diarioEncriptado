# Copia este archivo a .env.local y rellena los valores.
# Ninguna variable lleva NEXT_PUBLIC_: el navegador nunca habla con Supabase.
#
# En local, obtén las tres primeras con:  npx supabase status -o env

# URL de la API de Supabase (local: http://127.0.0.1:54321)
SUPABASE_URL=

# Clave publicable (sb_publishable_… o la antigua "anon"). Actúa con la sesión del usuario y RLS.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_… o la antigua "service_role"). SALTA RLS: solo servidor, nunca en el cliente ni en git.
SUPABASE_SECRET_KEY=

# Secreto del HMAC del limitador de login (al menos 32 caracteres aleatorios).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOGIN_THROTTLE_SECRET=

# URL pública de la app (local: http://localhost:3000)
APP_URL=http://localhost:3000
